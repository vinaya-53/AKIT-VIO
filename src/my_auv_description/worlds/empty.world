<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="ocean_world">
    <include>
      <uri>model://sun</uri>
    </include>

    <scene>
      <ambient>0.2 0.2 0.2 1</ambient>
      <background>0.0 0.1 0.2 1</background>
      <fog>
        <color>0.0 0.1 0.2 1</color>
        <type>linear</type>
        <start>10</start>
        <end>100</end>
      </fog>
    </scene>

    <include>
      <uri>model://ocean</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://seabed</uri>
      <pose>0 0 -20 0 0 0</pose>
    </include>
    
    <include>
      <uri>model://fish</uri>
      <pose>2 0 -5 0 0 0</pose> 
    </include>
    
  </world>
</sdf>
